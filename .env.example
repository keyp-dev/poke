# Copy to .env and fill in your own values (direnv loads it automatically).

# Cloudflare account id — used by wrangler to pick the account for deploy.
# Find it with `wrangler whoami` or in the Cloudflare dashboard URL.
CLOUDFLARE_ACCOUNT_ID=

# D1 database id — from `wrangler d1 create poke-db`.
# Injected into wrangler.toml by the `gen` script before dev/deploy.
D1_DATABASE_ID=
