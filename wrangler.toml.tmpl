name = "poke"
main = "src/index.ts"
compatibility_date = "2024-06-01"
# account_id is read from the CLOUDFLARE_ACCOUNT_ID environment variable.

# Replace with your own custom domain (or remove this block to use a workers.dev subdomain).
routes = [
  { pattern = "poke.keyp.dev", custom_domain = true }
]

[[rules]]
type = "Text"
globs = ["**/*.md"]
fallthrough = true

[[d1_databases]]
binding = "DB"
database_name = "poke-db"
# Injected from the D1_DATABASE_ID env var by the `gen` script. Do not hardcode.
database_id = "${D1_DATABASE_ID}"
